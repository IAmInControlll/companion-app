{
  "expo": {
    "name": "Chalkmates",
    "slug": "chalkmates",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chalkmates",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1B2420",
    "ios": {
      "bundleIdentifier": "app.chalkmates",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "app.chalkmates",
      "adaptiveIcon": {
        "backgroundColor": "#2F4A3A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B2420",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/PatrickHand-Regular.ttf",
            "./assets/fonts/ChalkIcons-Regular.ttf",
            "./assets/fonts/ChalkIcons-Filled.ttf",
            "./node_modules/@expo-google-fonts/nunito/400Regular/Nunito_400Regular.ttf",
            "./node_modules/@expo-google-fonts/nunito/600SemiBold/Nunito_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/nunito/700Bold/Nunito_700Bold.ttf",
            "./node_modules/@expo-google-fonts/nunito/800ExtraBold/Nunito_800ExtraBold.ttf"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Chalkmates shares your approximate location with your people so you can see how far apart you are."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick photos to share with your people.",
          "cameraPermission": "Snap photos to share with your people."
        }
      ],
      "@react-native-firebase/app",
      [
        "@react-native-firebase/messaging",
        {
          "android": {
            "notificationIcon": "./assets/notification-icon",
            "notificationColor": "#F7A8C4"
          }
        }
      ],
      [
        "./plugins/withNotificationIcon",
        {
          "iconDir": "assets/notification-icon",
          "color": "#F7A8C4"
        }
      ],
      "./plugins/withLocalNotifications",
      "expo-notifications",
      "./plugins/withWidgetResize",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/PatrickHand-Regular.ttf",
            "./assets/fonts/ChalkIcons-Regular.ttf",
            "./assets/fonts/ChalkIcons-Filled.ttf",
            "./node_modules/@expo-google-fonts/nunito/400Regular/Nunito_400Regular.ttf",
            "./node_modules/@expo-google-fonts/nunito/600SemiBold/Nunito_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/nunito/700Bold/Nunito_700Bold.ttf",
            "./node_modules/@expo-google-fonts/nunito/800ExtraBold/Nunito_800ExtraBold.ttf"
          ],
          "widgets": [
            {
              "name": "Chalkboard",
              "label": "Chalkboard",
              "description": "Their latest board, right on your home screen",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "minResizeWidth": "40dp",
              "minResizeHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "updatePeriodMillis": 3600000
            },
            {
              "name": "Mood",
              "label": "Mood",
              "description": "How your people are feeling",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "minResizeWidth": "40dp",
              "minResizeHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "updatePeriodMillis": 3600000
            },
            {
              "name": "MissYou",
              "label": "Miss you",
              "description": "Send a miss you, hug, kiss or poke in one tap",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "minResizeWidth": "40dp",
              "minResizeHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "updatePeriodMillis": 3600000
            },
            {
              "name": "Distance",
              "label": "Distance",
              "description": "How far apart you are",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "minResizeWidth": "40dp",
              "minResizeHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "updatePeriodMillis": 3600000
            },
            {
              "name": "Countdown",
              "label": "Countdown",
              "description": "Days until your next special day",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "minResizeWidth": "40dp",
              "minResizeHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Streak",
              "label": "Streak",
              "description": "How many days in a row you've shown up",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "minResizeWidth": "40dp",
              "minResizeHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "app.chalkmates.widgets",
          "groupIdentifier": "group.app.chalkmates",
          "widgets": [
            {
              "name": "Chalkboard",
              "displayName": "Chalkboard",
              "description": "Their latest board, right on your home screen",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "Mood",
              "displayName": "Mood",
              "description": "How your people are feeling",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "MissYou",
              "displayName": "Miss you",
              "description": "Send a miss you, hug, kiss or poke in one tap",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "Distance",
              "displayName": "Distance",
              "description": "How far apart you are",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "Countdown",
              "displayName": "Countdown",
              "description": "Days until your next special day",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "Streak",
              "displayName": "Streak",
              "description": "How many days in a row you’ve shown up",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "contentMarginsDisabled": true
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a1f551f7-a7da-4101-98c8-ed5ad036e1e0"
      }
    },
    "owner": "iamincontrol",
    "web": {
      "favicon": "./assets/images/favicon.png"
    }
  }
}
